{
  "name": "@fringeworks/react-defer-rendering",
  "version": "0.9.0",
  "private": true,
  "description": "A library some will find handy, specialized in deferring the rendering of components until a specified condition is met.",
  "keywords": [
    "react",
    "layout",
    "style"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fringeworks-js/react-defer-rendering.git"
  },
  "license": "MIT",
  "author": "Mitsuhiro Seino",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*/index.ts"
  },
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json}\"",
    "indexes": "tsx scripts/indexes.ts",
    "lint": "eslint .",
    "release": "pnpm build && npm publish ./dist",
    "test": "vitest",
    "tidy": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json}\" --config ./prettier.tidy.config.ts"
  },
  "dependencies": {
    "@fringeworks/react-utils": "^0.9.0",
    "@fringeworks/types": "^0.9.1",
    "@fringeworks/utils": "^0.11.1",
    "@fringeworks/web-font-observer": "^0.9.0"
  },
  "devDependencies": {
    "@fringeworks/dev": "^0.13.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^25.9.9",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.12.0",
    "fast-glob": "^3.3.3",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.10",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rimraf": "^6.1.3",
    "tsdown": "^0.23.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "packageManager": "pnpm@12.3.4+sha512.961aa41fb077da3a04a441d9f8e15ebc0c96da8ef710b2eb67bf9ee7cb0610eabd48f1fd85f51cffe73846785fa0f87c56a3a872a1d893f8446741b5cce45457"
}
